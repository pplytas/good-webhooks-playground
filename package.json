{
  "name": "good-webhooks-playground",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "node --env-file-if-exists=.env --watch src/worker/main.ts",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env src/worker/main.ts",
    "setup": "node --env-file-if-exists=.env scripts/setup.ts",
    "ban": "node --env-file-if-exists=.env scripts/ban.ts",
    "typecheck": "next typegen && tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "good-webhooks": "0.3.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "railway": "3.16.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
